pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
t=0
walk=0
lvl = {8,9,9,9, 9,9,9,9,9}
gnd = {14,15,17,18,15,18,16,17, 18,18,16,17,18,15,17,18}

function _init()
	lvl[0] = 18
	music(0)
end

function _draw()
	t+=1
	
	cls(0)
	
	--sky and ground
	rectfill(0,0,128,128,12)
	for j=0,128,8 do
		for k=64,120,8 do
			lv=((k/8)%8)
			spr(lvl[lv],j-walk%8,k)
		end
	end
	
	-- walkguy animation
	if (t%3) == 2 then walk+=1 end
	spr((walk%7),64,64)
	
end

function _update()
	_draw()
end
