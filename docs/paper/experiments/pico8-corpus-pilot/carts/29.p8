pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--mario game

--by remagamer and also
--sockfoot

function _init()

 mariox=64
 marioy=64
 marioxt=false
 marioyt=false
 mariovx=rnd(1)
 mariovy=rnd(1)

end

function _update()

 if marioxt then
  mariox-=mariovx
 else
  mariox+=mariovx
 end
 if marioyt then
  marioy-=mariovy
 else
  marioy+=mariovy
 end
 
 if marioy>=120 then
  marioyt=true
  mariovy=rnd(1)
 elseif marioy<=0 then	
  marioyt=false
  mariovy=rnd(1)
 end
 if mariox>=120 then
  marioxt=true
  mariovx=rnd(1)
 elseif mariox<=0 then
  marioxt=false
  mariovx=rnd(1)
 end
end

function _draw()
 
 cls(5)
 spr(1,mariox,marioy)

end
