pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
dvd = {}
dvd.x = 1
dvd.dx = 1
dvd.y = 1
dvd.dy = 1
dvd.r = 2
dvd.c = 0
function _init()
	cls()
end
function _update()
	dvd.x=dvd.x+dvd.dx
	dvd.y=dvd.y+dvd.dy
	dvd.c=dvd.c+1
	if dvd.x>127 then
		dvd.dx=-1
	end
	if dvd.x<0 then
		dvd.dx=1
	end
	if dvd.y>127 then
		dvd.dy=-1
	end
	if dvd.y<0 then
		dvd.dy=1
	end
end
function _draw()
	cls()
	--circfill(ball.x, ball.y, ball.r, ball.c)
	spr(1, dvd.x,dvd.y)
end
