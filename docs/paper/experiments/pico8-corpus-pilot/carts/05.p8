pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--∧sinesurfer∧
--by: cfd
cnt=0
scn=0
bgspr=0
txc=0
ps={}
txt={"greetings all!!!",
					"cfd here with my 2nd demo",
					"presenting:",
					"∧sinesurfer∧",
					"!!!",
					"♪",
					"we've got",
					"plasma and",
					"copper and",
					"ribbons galore! ♥♥♥",
					"--",
					"thanks to",
					"lexaloffle",
					"for pico-8!",
					"!!!",
					"it's fun as heck...",
					"--",
					"and on that note",
					"i'll leave you to the gfx",
					"thanks for watching!",
					"!!!"}

function part()
	return {x=64,y=64,vx=rnd(2)-1,vy=rnd(2)-1}
end

function _init()
	music(0)
	for i=1,256 do
		add(ps,part())
	end
end

function _update()
	cnt=cnt+1
	if (cnt%100==0) then
		txc=txc+1
	end
	if (cnt%300==0) then
		scn=(scn+1)%3
	end
end

function _draw()
	if (scn==0) then
		ribbons()
	elseif (scn==1) then
		copper()
	elseif (scn==2) then
		plasma()
	end
	scroller()
end

function plasma()
	cls()
	for x=0,64 do
		for y=0,64 do
			c=flr(
				sin((cnt+x)/40)*2 +
				sin((cnt+x+y)/60)*2 *
				sin(cnt/180)
			)
			rectfill(x*4,y*4,x*4+4,y*4+4,c)
		end
	end
end

function copper()
	cls()

	for i=1,#ps do
		p=ps[i]
		p.x=p.x+p.vx*4
		p.y=p.y+p.vy*4
		pset(p.x,p.y,6)
		if ((p.x<0 or p.x>128) and (p.y<0 or p.y>128)) then
			p.x=64
			p.y=64
		end
	end
	
	cols={4,9,10,7,10,9,4}
	for n=0,30 do
		for i=1,#cols do
			y=64+i+sin((n*2+cnt)/80)*22
			y=y+sin(cnt/40)*10
			s=sin(cnt/100)*8
			line(n+8+s,y,128-8-s-n,y,cols[i])
		end
	end
end

function ribbons()
	cls()
	
	for x=0,16 do
		for y=0,16 do
			xx=(cnt+x*8)%136
			spr(2,xx-8,y*8)
		end
	end
	
	cx=30+sin(cnt/80)*20
	cy=30+sin(cnt/60)*20
	cs=68
	clip(cx,cy,cs,cs)
	rectfill(cx,cy,cx+cs,cy+cs,0)
	
	for x=0,16 do
		for y=0,16 do
			s=(x%2==0 and 1 or 0)
			spr(s,(cnt+x*8)%128,y*8)
		end
	end
	
	for y=cy,cy+cs do		
		x=80+sin(((y*2)+cnt)/50)*4
		x=x+sin((y+cnt)/70)*8
		line(x,y,x+16,y,3)
		sz=abs(sin(cnt/90)*4)
		sz=sz+abs(sin(cnt/80)*4)-1
		line(x+16-sz,y,x+16,y,11)
		
		x=36+sin(((y*2)+cnt)/40)*4
		x=x+sin((y+cnt)/76)*8
		line(x,y,x+16,y,1)
		sz=abs(sin(cnt/77)*4)
		sz=sz+abs(sin(cnt/78)*4)-1
		line(x+16-sz,y,x+16,y,12)
		
		x=56+sin((y+cnt)/40)*4
		x=x+sin(((y*3)+cnt)/80)*8
		line(x,y,x+16,y,8)
		sz=abs(sin(cnt/60)*4)
		sz=sz+abs(sin(cnt/90)*4)-1
		line(x+16-sz,y,x+16,y,15)
		
		rect(cx,cy,cx+cs-1,cy+cs-1,7)
		pset(cx,cy,0)
		pset(cx+cs-1,cy,0)
		pset(cx,cy+cs-1,0)
		pset(cx+cs-1,cy+cs-1,0)
	end
end

function scroller()
	if (txc>=#txt) then
		return
	end

	by=104+sin(cnt/50)*4
	t=txt[1+txc]
 tx=64-(#t/2)*4
 
	clip(0,0,128,128)
	line(0,by,128,by,6)
	rectfill(0,by+1,128,by+7,0)
	print(t,tx,by+2,9)
	clip(0,by+2,128,2)
	print(t,tx,by+2,10)
	clip(0,0,128,128)
	line(0,by+8,128,by+8,6)
end
