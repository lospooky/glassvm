pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--1 knoll

function drawknoll(offset,f1,sc)

 local c=sc
 for x=-44+offset,44+offset,8 do
  local x1,x2=x-58,x+60
  local xt=x*x*.000025+f1
  for y=-100,100,2 do
   local yt=y*y*.000025
   local z=-3/sqrt(xt+yt)+40
   local ny,nz=y-x1,z+x2
   line(ny,nz,ny,199,colors[c])
   line(ny+1,nz,ny+1,199,colors[c])
   pset(ny,nz,0)
   pset(ny+1,nz,0)
   if y==0 then
    palt(0,false)
    palt(12,true)
    spr(2,ny-3+sin(time()+y)*4,nz-12+sin(time())*4)
   end
   py=ny
   pz=nz
  end
  c+=1
  if c>4 then
   c=1
  end
 end

end

function _init()
 music(0)
	offset=0
	f1=.01
	f1s=-.0001
	colors={1,3,11,13}
	sc=1
end

function _update()
 offset+=.5
 if offset>=8 then
  offset=0
  sc-=1
  if sc<1 then
   sc=4
  end
 end
 if f1<.001 or f1>.01 then
  f1s=-f1s
 end
 f1+=f1s
end

function _draw()
	cls()
	drawknoll(offset,f1,sc)
	print("1 knoll",0,0,7)
end
