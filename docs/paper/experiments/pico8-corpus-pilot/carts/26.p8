pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- collision coding method
-- written by dw817 (11-26-19)

-- standard ⌂ pico-8 license

-- taking an old video-game
-- example i show a unique way
-- in pico-8 for determining
-- a collision between two-
-- sprites. not by the standard
-- hit-box but by actual pixel
-- collisions. considerably
-- more accurate.

function _init()

  playx={}
  playy={}
  playt={}
  score={}

-- starting score of both
-- players.
  score[0]=0
  score[1]=0

-- starting location of both
-- players.
  playx[0]=64-20-16
  playx[1]=64+20
  playy[0]=112
  playy[1]=112

-- starting timeout of both
-- players.
  playt[0]=32
  playt[1]=64

  starx={}
  stary={}
  stars={}

-- starting location of each
-- of the 7-stars.
  for i=0,6 do
    starx[i]=rnd(128)
    stary[i]=i*16

-- set the speed of each star.
    stars[i]=(7-i)/6
    if i%2==0 then
      stars[i]=-stars[i]
    end    
  end
end

function _draw()

  cls()
  for i=0,1 do

-- simple draw rockets and
-- score.
    sspr(0,0,16,16,playx[i],playy[i])
    print(score[i],34+i*56,0)
  end

  for i=0,6 do

-- simple draw stars.
    sspr(16,0,16,16,starx[i],stary[i])

  end

end

function _update()
  for i=0,1 do
  
-- if rocket timeout is done,
-- go to move them now.
    if playt[i]>0 then
      playt[i]-=1
    else
      if playt[i]<0 then
        playt[i]+=1
        if playt[i]==0 then
          playt[i]=16
        end
      end
      playy[i]-=1
    end

-- ding, player gained a point.
    if playy[i]<-16 then
      sfx(1)
      playy[i]=128
      playt[i]=-16
      score[i]+=1
    end
  end

-- move the stars
  for i=0,6 do
    starx[i]+=stars[i]
    if starx[i]<-16 then
      starx[i]+=144
    elseif starx[i]>128 then
      starx[i]-=144
    end
  end

-- check by spritesheet pixels
-- for a possible collision.
  for i=0,6 do
    for j=0,1 do
      hit=collide(16,0,16,16,starx[i],stary[i],0,0,16,16,playx[j],playy[j])

-- did a rocket hit a star?
-- yes? then move it back a
-- step with sound effect.
      if hit==true then
        playy[j]+=2
        sfx(0)

-- also give it a bit of a
-- pause before continuing
        playt[j]=10

      end
    end
  end

end

-- my collision routine uses
-- several arguments to compare
-- two different sprites which
-- could also be different in
-- sizes and shapes. it will
-- still work correctly.

-- sh1=spritesheet source x
-- sv1=spritesheet source y
-- sx1=spritesheet size x
-- sy1=spritesheet size y
-- ph1=screen position x
-- pv1=screen position y
-- sh2=spritesheet source x
-- sv2=spritesheet source y
-- sx2=spritesheet size x
-- sy2=spritesheet size y
-- ph2=screen position x
-- pv2=screen position y

function collide(sh1,sv1,sx1,sy1,ph1,pv1,sh2,sv2,sx2,sy2,ph2,pv2)
local ok,x,y=0
  if (sx1*sy1>sx2*sy2) sh1,sv1,sx1,sy1,ph1,pv1,sh2,sv2,sx2,sy2,ph2,pv2=sh2,sv2,sx2,sy2,ph2,pv2,sh1,sv1,sx1,sy1,ph1,pv1
  for i=0,sy1-1 do
    for j=0,sx1-1 do
      x=j+ph1-ph2 y=i+pv1-pv2
      if (x>=0 and x<sx2 and y>=0 and y<sy2 and sget(sh1+j,sv1+i)>0 and sget(sh2+x,sv2+y)>0) return true
    end
  end
  return false
end

