pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- pico aquarium
-- by woodsmoke

function _init()
	cls()
	poke(0x5f2c, 3)
	
	b1_x=rnd(63)
	b2_x=rnd(63)
	b3_x=rnd(63)
 b1_y=rnd(63)
 b2_y=rnd(63)
 b3_y=rnd(63)
	f1_x=rnd(63)
	f1_y=rnd(63)
	s1=rnd(7)+1
	v1=(rnd(0.2)+0.2)*(-1)
	f2_x=rnd(63)
	f2_y=rnd(63)
	s2=rnd(7)+1
	v2=(rnd(0.2)+0.2)*(-1)
	f3_x=rnd(63)
	f3_y=rnd(63)
	s3=rnd(7)+1
	v3=(rnd(0.2)+0.2)*(-1)
	f4_x=rnd(63)
	f4_y=rnd(63)
	s4=rnd(7)+1
	v4=(rnd(0.2)+0.2)*(-1)
	f5_x=rnd(63)
	f5_y=rnd(63)
	s5=rnd(7)+1
	v5=rnd(0.2)+0.2
	f6_x=rnd(63)
	f6_y=rnd(63)
	s6=rnd(7)+1
	v6=rnd(0.2)+0.2
	f7_x=rnd(63)
	f7_y=rnd(63)
	s7=rnd(7)+1
	v7=rnd(0.2)+0.2
	f8_x=rnd(63)
	f8_y=rnd(63)
	s8=rnd(7)+1
	v8=rnd(0.2)+0.2
	f9_x=rnd(63)
	f9_y=rnd(63)
	s9=rnd(7)+1
	v9=rnd(0.2)+0.2
	f10_x=rnd(63)
	f10_y=rnd(63)
	s10=rnd(7)+1
	v10=rnd(0.2)+0.2
	f11_x=rnd(63)
	f11_y=rnd(63)
	s11=rnd(7)+1
	v11=rnd(0.2)+0.2
	
	plant=0
end


function _update()

if b1_y<0 then b1_y=63 b1_x=rnd(63) end
if b2_y<0 then b2_y=63 b2_x=rnd(63) end
if b3_y<0 then b3_y=63 b3_x=rnd(63) end


plant+=0.02
if plant>2 then plant=0 end

//fish move
	f1_x+=v1
	f2_x+=v2
	f3_x+=v3
	f4_x+=v4
	f5_x+=v5	
	f6_x+=v6
	f7_x+=v7
	f8_x+=v8
	f9_x+=v9
	f10_x+=v10
	f11_x+=v11
	
//fish change dir
	if f1_x<-22 or f1_x>70 then
	f1_y=rnd(63)
	v1=rnd(0.3)+0.1
	s1=rnd(7)+1
	end
	if f1_x>70 then v1=v1*-1 end
	
	if f2_x<-22 or f2_x>70 then
	f2_y=rnd(63)
	v2=rnd(0.3)+0.1
	s2=rnd(7)+1
	end
	if f2_x>70 then v2=v2*-1 end
	
	if f3_x<-22 or f3_x>70 then
	f3_y=rnd(63)
	v3=rnd(0.3)+0.1
	s3=rnd(7)+1
	end
	if f3_x>70 then v3=v3*-1 end
	
	if f4_x<-22 or f4_x>70 then
	f4_y=rnd(63)
	v4=rnd(0.3)+0.1
	s4=rnd(7)+1
	end
	if f4_x>70 then v4=v4*-1 end
	
	if f5_x<-22 or f5_x>70 then
	f5_y=rnd(63)
	v5=rnd(0.3)+0.1
	s5=rnd(7)+1
	end
	if f5_x>70 then v5=v5*-1 end
	
	if f6_x<-22 or f6_x>70 then
	f6_y=rnd(63)
	v6=rnd(0.3)+0.1
	s6=rnd(7)+1
	end
	if f6_x>70 then v6=v6*-1 end
	
	if f7_x<-22 or f7_x>70 then
	f7_y=rnd(63)
	v7=rnd(0.3)+0.1
	s7=rnd(7)+1
	end
	if f7_x>70 then v7=v7*-1 end
	
	if f8_x<-22 or f8_x>70 then
	f8_y=rnd(63)
	v8=rnd(0.3)+0.1
	s8=rnd(7)+1
	end
	if f8_x>70 then v8=v8*-1 end
	
	if f9_x<-22 or f9_x>70 then
	f9_y=rnd(63)
	v9=rnd(0.3)+0.1
	s9=rnd(7)+1
	end
	if f9_x>70 then v9=v9*-1 end
	
	if f10_x<-22 or f10_x>70 then
	f10_y=rnd(63)
	v10=rnd(0.3)+0.1
	s10=rnd(7)+1
	end
	if f10_x>70 then v10=v10*-1 end
	
	if f11_x<-22 or f11_x>70 then
	f11_y=rnd(63)
	v11=rnd(0.3)+0.1
	s11=rnd(7)+1
	end
	if f11_x>70 then v11=v11*-1 end

	b1_y-=0.1
	b2_y-=0.1
	b3_y-=0.1
end

function _draw()
cls()
rectfill(0,0,63,63,1)

rectfill(b1_x,b1_y,b1_x,b1_y,6)
rectfill(b2_x,b2_y,b2_x,b2_y,6)
rectfill(b3_x,b3_y,b3_x,b3_y,6)

spr(8+plant,0,60)

spr(8+plant,6,56)
spr(8+plant,6,48)

spr(8+plant,16,56)
spr(8+plant,16,48)
spr(8+plant,16,40)
spr(8+plant,16,32)

spr(8+plant,22,56)
spr(8+plant,22,48)
spr(8+plant,22,40)

spr(8+plant,29,56)
spr(8+plant,29,48)
spr(8+plant,29,40)
spr(8+plant,29,32)
spr(8+plant,29,24)
spr(8+plant,29,16)
spr(8+plant,29,8)

spr(8+plant,38,56)
spr(8+plant,38,48)
spr(8+plant,38,40)
spr(8+plant,38,32)
spr(8+plant,38,24)
spr(8+plant,38,16)

spr(8+plant,46,56)
spr(8+plant,46,48)
spr(8+plant,46,40)

spr(8+plant,56,56)

spr(s1,f1_x,f1_y)
spr(s1,f1_x+9,f1_y)
spr(s2,f2_x,f2_y)
spr(s2,f2_x+9,f2_y)
spr(s3,f3_x,f3_y)
spr(s3,f3_x+9,f3_y)
spr(s4,f4_x,f4_y)
spr(s4,f4_x+9,f4_y)
spr(s5,f5_x,f5_y)
spr(s5,f5_x+9,f5_y)
spr(s6,f6_x,f6_y)
spr(s6,f6_x+9,f6_y)
spr(s7,f7_x,f7_y)
spr(s7,f7_x+9,f7_y)
spr(s8,f8_x,f8_y)
spr(s8,f8_x+9,f8_y)
spr(s9,f9_x,f9_y)
spr(s9,f9_x+9,f9_y)
spr(s10,f10_x,f10_y)
spr(s10,f10_x+9,f10_y)
spr(s11,f11_x,f11_y)
spr(s11,f11_x+9,f11_y)


end


