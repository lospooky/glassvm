pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--♥happy b'day gura♥
--from waltz


function _init()
	--change palete
 pal(2,140,1)
 pal(3,142,1)
 pal(9,133,1)
 pal(10,136,1)
 pal(11,143,1)
 palt(0, false)
  
 g={}
 g.frm=1
 g.mxfrm=8
 g.sprt=0
 g.frms={76,70,64,166,172,166,64,70} 
 g.x=48
 g.y=70
 g.flip=false
 
 grim={}
 grim.act=false
 grim.f={7,4,1}
 laff={}
 laff.act=false
 laff.f={39,36,33}
 
 music(0)
 
 cntr=0
end

function _update()
	
	local curfrm=g.frm
	
	--animation spd fps
 local s = 5
 --current frame
	g.frm=flr(time()*s%g.mxfrm)+1
	g.sprt=g.frms[g.frm]
	
	if (g.frm==6 and curfrm!=g.frm) then 
		g.flip=true
		g.x-=16
	elseif (g.frm==1 and g.flip and curfrm!=g.frm) then
		g.flip=false
		g.x+=16
	end
	
	if g.frm==7 and curfrm!=g.frm then
	 cntr+=1
	end
	
	if cntr==7 then
	 laff.act=true
	end
	
	if laff.act==true and cntr==9 then
		laff.act=false
 end	
 
 if cntr==17 then
	 grim.act=true
	end
	
	if grim.act==true and cntr==18 then
		grim.act=false
		cntr=0
 end	 
 	
end


function _draw()
	cls(7)
	--main sprite
	spr(g.sprt,g.x,g.y,6,6,g.flip)

	--paste on coat mouth when lft
	if g.frm==2 then
		spr(12,g.x+16,g.y+24,2,2)
	end
	if g.frm==3 then
	 spr(44,g.x+16,g.y+24,2,2)
	end
	if g.frm==4 then
	 spr(42,g.x+8,g.y+24,2,2)
	end
		if g.frm==6 then
	 spr(10,g.x+16,g.y+24,2,2)
	end
	
	-- extra expressions
	if grim.act or laff.act then
			local ptr
			if grim.act then
				ptr = grim
			end
			if laff.act then
			 ptr = laff
			end
		
			-- only update expression when facing
	 	if g.frm==1 then
				spr(ptr.f[1],g.x,g.y+8,3,2)
			end
			if g.frm==2 then
			 spr(ptr.f[2],g.x,g.y+8,3,2)
			end
			if g.frm==3 then
			 spr(ptr.f[3],g.x,g.y+8,3,2)
			end
			if g.frm==7 then
			 spr(ptr.f[3],g.x+24,g.y+8,3,2,true)
			end
			if g.frm==8 then
			 spr(ptr.f[2],g.x+24,g.y+8,3,2,true)
			end
			if g.frm==9 then
			 spr(ptr.f[1],g.x+24,g.y+8,3,2,true)
			end
	end
	
	-- emotes
	if grim.act then
		local off=0
		if g.flip then
			off=16
		end
		-- facing only
		if g.frm<4 or g.frm>6 then
		 spr(14,g.x-13+off,g.y-13,2,2)
		 spr(46,g.x+32+off,g.y+8,2,2)
	 end
	end
end


