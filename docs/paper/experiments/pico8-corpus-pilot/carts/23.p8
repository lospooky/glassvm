pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
cnt=0
scn=0
s=0
txr={}
tc=0
tx=-64
txt={
	"hello everyone",
	"presenting my first demo",
	"for pico-8",
	"██phases██",
	"",
	"code/gfx/snd by cfdrake",
	"",
	"hope you enjoy",
	"!!!",
	"",
	"<esc> to quit",
	"but why would you??",
	"...",
	"★⬇️✽●♥웃⌂⬅️",
	"▥❎🐱ˇ▒♪😐",
	"◆🅾️☉⬆️▤⧗➡️░",
}

function _init()
	music(0)
	for x=0,11 do
		txr[x]={}
		for y=0,11 do
			txr[x][y]=8+rnd(6)
		end
	end
end

function _update()
	cnt=cnt+1
	if (cnt%140==0) then
		scn=(scn+1)%5
	end
	if (cnt%140==0) then
		tc=(tc+1)%count(txt)
		tx=-64
	end
end

function _draw()
	if (scn==0) then
		trains()
	elseif (scn==1) then
		lines()
	elseif (scn==2) then
		stars()
	elseif (scn==3) then
		eyes()
	elseif (scn==4) then
		pulses()
	end
	drawtext()
end

function lines()
	cls()
	for i=1,64 do
		x=i*2
		color(2)
		sz=4+sin(cnt/80)*20
		y=20+sin((i+cnt)/70)*sz
		yy=90+sin((i+cnt)/70)*sz
		z=sin(cnt/40)*8
		line(x,y+z,x,yy+z)
	end
	for i=1,64 do
		x=1+i*2
		color(1)
		sz=4+sin(cnt/60)*20
		y=20+sin((i+cnt)/60)*sz
		yy=90+sin((i+cnt)/60)*sz
		z=sin(cnt/70)*8
		line(x,y+4+z,x,yy+4+z)
	end
end

function trains()
	cls()
	drawtrain(1,0,120)
	drawtrain(2,80,104)
	print("",0,0)
end

function drawtrain(s,o,rr)
	for i=0,18 do
		r=28+sin(cnt/100)*16
		x=64+sin((o+i*4+cnt)/(rr+8))*r
		y=64+sin((o+i*4+cnt)/rr)*r
		spr(s,x,y)
	end
end

function stars()
	cls()
	for i=0,16 do
		c=i
		x=64+sin((i*4+cnt)/40)*10
		y=64+sin((i*4+cnt)/50)*10
		circfill(x,y,100-(i*8),c)
	end
end

function eyes()
	cls()
	if (cnt%40==0) then
		s=(s+1)%5
	end
	for i=0,32 do
		x=(i*8)
		for j=-2,2 do
			y=64+(j*8)+sin((i+cnt)/80)*20+sin((i+cnt)/40)*10
			spr(3+s,x,y)
		end
	end
end

function pulses()
	cls()
	
	if (cnt%3==0) then
		for x=0,11 do
			txr[x]={}
			for y=0,11 do
				txr[x][y]=8+rnd(10)
			end
		end
	end
	
	for x=0,11 do
		for y=0,11 do
			spr(txr[x][y],16+x*8,16+y*8)
		end
	end
end

function drawtext()
	tx=tx+2
	print(txt[1+tc],tx,122,10)
end
