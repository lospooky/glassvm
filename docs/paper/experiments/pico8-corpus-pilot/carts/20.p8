pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- mountain
-- by potato imaginator

function _init()
 t=0
 tau=2*3.1415926
end

function _update()
 t=t+1/20
end

function _draw()
 cls(12)
 for i=-64,64 do
  for j=1,25 do
   local c=0
   if
   j*cos((i/(35-j)+t)/tau)<0
   then
    c=-1
   end
   
   line
   (64+i,
    32+8*j
    -4*j*cos((i/(35-j)+t)/tau),
    64+i,128,
    9+j%2+c)
   pset
   (64+i,
    32+8*j
    -4*j*cos((i/(35-j)+t)/tau),
    8+6*c)
  end
 end
end
