pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--dvd game
--by cupps
dvdx=flr(rnd(82))+1
dvdy=flr(rnd(105))+1
dvdangle=flr(rnd(4))
colid=0
corner=0
bump=0

function _init()
		dvdangles()
end

function dvdangles()
	if dvdangle==0 then
		dvdxspeed=1
		dvdyspeed=1
	end
	if dvdangle==1 then
		dvdxspeed=1
		dvdyspeed=-1
	end
	if dvdangle==2 then
		dvdxspeed=-1
		dvdyspeed=1
	end
	if dvdangle==3 then
		dvdxspeed=-1
		dvdyspeed=-1
	end
end

function cor()
	if dvdx==0 then
		if dvdy==106 then
			corner=corner+1
			bump=bump-1
			colid=colid-1
		end
		if dvdy==0 then
			corner=corner+1
			bump=bump-1
			colid=colid-1
		end
	end
	if dvdx==83 then
		if dvdy==106 then
			corner=corner+1
			bump=bump-1
			colid=colid-1
		end
		if dvdy==0 then
			corner=corner+1
			bump=bump-1
			colid=colid-1
		end
	end
end

function col()
	if colid==0 then
		pal (7,8)
	end
	if colid==1 then
		pal (7,9)
	end
	if colid==2 then
		pal (7,10)
	end
	if colid==3 then
		pal (7,11)
	end
	if colid==4 then
		pal (7,12)
	end
	if colid==5 then
		pal (7,14)
	end
	if colid>5 then
		colid=0
	end
end

function _update()
	dvdx=dvdx+dvdxspeed
	dvdy=dvdy+dvdyspeed
		if dvdx==83 then
		dvdxspeed=-1
		colid=colid+1
		bump=bump+1
		sfx(0)
	end
		if dvdy==106 then
		dvdyspeed=-1
		colid=colid+1
		bump=bump+1
		sfx(0)
	end
		if dvdx==0 then
		dvdxspeed=1
		colid=colid+1
		bump=bump+1
		sfx(0)
	end
		if dvdy==0 then
		dvdyspeed=1
		colid=colid+1
		bump=bump+1
		sfx(0)
	end
	cor()
end

function drawdvd()
	spr(1,dvdx,dvdy,6,3)
end

function _draw()
	cls()
	rect(0,0,127,126,5)
	col()
	print(corner,5,110,5)
	print(bump,5,117,5)
	drawdvd()
end
