pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
local turtle

function _init()
 turtle={
 	x=32,
 	y=32,
 	c=10
 }
 music(0)
 cls()
end

function _update()
 turtle.x-=cos(t())*t()
 turtle.y-=sin(t())*t()
 turtle.c=rnd(14)
end

function _draw()
 pset(turtle.x,turtle.y,turtle.c)
end
