pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
saria = {}
saria.x = 45
saria.y = 60

timer = {}
timer.s = 0
timer.bol = false

function  _init()
music(0)
end


function thetime()
timer.s += 1/30
if(timer.s <= 2) timer.bol = true
if(timer.s >= 2) timer.bol = false
if(timer.s >= 4) timer.s = 0
end

function move_fairy()
if(timer.bol == true)saria.y-=0.1
if(timer.bol == false)saria.y+=0.1
end

function _update()
thetime()
move_fairy()
end

function rectfills()
rectfill(0,0,saria.x,128,3)
rectfill(0,0,128,saria.y,3)
rectfill(0,saria.y+48,128,128,3)
rectfill(saria.x+32,0,128,128,3)

end

function _draw()
cls()
rectfills()
print("saria's song",39,35,0)
print("koji kondo",85,120,0)
spr(0,saria.x,saria.y,4,6)
end


