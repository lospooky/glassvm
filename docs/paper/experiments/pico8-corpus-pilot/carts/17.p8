pico-8 cartridge // http://www.pico-8.com
version 42
__lua__

-- dvd bounce
-- by GabuGabu and Sickynar

cls()

function _init()
	state = "bounce"

	-- constants 
	ZOOM_MAX = 2
	ZOOM_INTERVAL = 15
	ZOOM_STEP = 0.25

	-- zoom vars
	zoom_level = 1
	zoom_frames = ZOOM_INTERVAL
	zoom_steps = 0
	zoom_corner = {
		x = TOP,
		y = LEFT,
	}
	dcamera = {
		x = 0,
		y = 0,
	}



	-- the bounds considering the sprite dimensions
	TOP = 1
	RIGHT = 97
	BOTTOM = 112
	LEFT = -1

	-- create the dvd
	dvd = {
		x = rnd(30) + 30,
		y = rnd(30) + 30,
		vx = 1.2,
		vy = 1.2,
		speed = 1.2,
		hue = 1,
		sprite = 17, 
		sprite_width = 4,
		sprite_height = 2,
		zoom_x = 0,
		zoom_y = 0,
		zoom_w = 0,
		zoom_h = 0,
	}

	function dvd:update()

		self.x += self.vx
		self.y += self.vy
		local bounced = self:check_wall_collision()

		if bounced.bounced then
			self.hue += 1
			if self.hue > 15 then
				self.hue = 1
			end 
		end 

		if bounced.x and bounced.y then
			state = "zoom"
			zoom_corner = {
				x = bounced.x,
				y = bounced.y
			}
			music(00)
		end

	end

	function dvd:draw()

		rect(0, 0, 127, 127, self.hue)
		pal(7, self.hue)
		spr(self.sprite, self.x, self.y, self.sprite_width, self.sprite_height, false, false)

	end

	function dvd:check_wall_collision()
		local bounced = {		
			top = (self.y < TOP) and 0,
			right = (self.x > RIGHT) and 127,
			bottom = (self.y > BOTTOM) and 127,
			left = (self.x < LEFT) and 0,
		}
		bounced.y = bounced.top or bounced.bottom
		bounced.x = bounced.left or bounced.right
		bounced.bounced = bounced.x or bounced.y

	
		-- mid called in these to stop "double bouncing" or getting stuck
		-- Collision with left or right walls
		if bounced.left or bounced.right then
			self.vx = -self.vx
			self.x = mid(LEFT, self.x, RIGHT)
		end
	
		-- Collision with top or bottom walls
		if bounced.top or bounced.bottom then
			self.vy = -self.vy
			self.y = mid(TOP, self.y, BOTTOM)
		end
	
		if bounced.bounced then
			self:adjust_angle_randomly()
		end

		return bounced
	end

	function dvd:adjust_angle_randomly()
		-- Randomize the velocity a bit
		self.vx += rnd(1) - 0.5 
		self.vy += rnd(1) - 0.5
	
		-- Normalize the velocity to maintain constant speed
		local v_length = sqrt(self.vx * self.vx + self.vy * self.vy)
		self.vx = (self.vx / v_length) * self.speed
		self.vy = (self.vy / v_length) * self.speed

	end

	function dvd:update_zoom()



		if zoom_frames == 0 then
			-- slowly zoom in

			zoom_steps += ZOOM_STEP
			zoom_level = min(zoom_level + zoom_steps, ZOOM_MAX)

			-- determine where to draw the zoomed in sprite and move the camera
			dcamera = {
				x = (zoom_corner.x - 64) * zoom_steps,
				y = (zoom_corner.y - 64) * zoom_steps,
			}
			camera(dcamera.x, dcamera.y)

			-- finally, set the state back to bounce
			if zoom_level >= ZOOM_MAX then
				state = "shake"
			end

			zoom_frames = ZOOM_INTERVAL

		else
			zoom_frames -= 1
		end
	
	end

	function dvd:update_shake()
		--shake the screen for a bit
		if zoom_frames == 0 then
			self:reset_zoom()
		else
			camera(dcamera.x + rnd(6) - 3, dcamera.y + rnd(6) - 3)
			zoom_frames -= 1
		end
	end 

	function dvd:reset_zoom()
		-- just reset some vars
		state = "bounce"
		zoom_level = 1
		zoom_frames = ZOOM_INTERVAL
		zoom_steps = 0
		dcamera.x = 0
		dcamera.y = 0
		camera()
	end

	function dvd:draw_zoom()

		line(zoom_corner.x, 0, zoom_corner.x, 127, self.hue)
		line(0, zoom_corner.y, 127, zoom_corner.y, self.hue)

		zoom_w = 32 * zoom_level
		zoom_h = 16 * zoom_level
		zoom_x = min(zoom_corner.x-1, 129 - zoom_w)
		zoom_y = min(zoom_corner.y, 127 - zoom_h)

		sspr(8, 8, 32, 16, zoom_x, zoom_y, zoom_w, zoom_h)

	end
	
	

end

function _update()

	if state == "bounce" then
		dvd:update()
	elseif state == "zoom" then
		dvd:update_zoom()
	elseif state == "shake" then
		dvd:update_shake()
	end

end

function _draw()
	cls()
	if state == "bounce" then
		dvd:draw()
	elseif state == "zoom" then
		dvd:draw_zoom()
	elseif state == "shake" then
		dvd:draw_zoom()
	end
end



