pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--robot waltz
--by quin

function _init()
 --runs at start of program
 
 cycle=false --default
 j=1
 
 --pick a color palette
 --green:
 --palette={15,7,11,10}
 --bg=3
 --sunset:
 --palette={14,9,10,8,2}
 --bg=1
 --rainbow:
 palette={8,9,10,11,12,13,2}
 bg=5
 cycle=true
 
 a=flr(rnd(127)) b=flr(rnd(127))
 c=flr(rnd(127)) d=flr(rnd(127))
 av=flr(rnd(5))-2
 bv=flr(rnd(5))-2
 cv=flr(rnd(5))-2
 dv=flr(rnd(5))-2
 rectfill(0,0,127,127,bg)
 color(rnd_col())
 i=0
end

function rnd_col()
 return(palette[flr(rnd(#palette-1)+1)])
end

function _update()
 i+=1
 --runs every frame (30fps)
 --move the ponts
 a+=av
 b+=bv
 c+=cv
 d+=dv
 --bounce off the wall
 if (a<0 or a>127) av=-av sfx(0)
 if (b<0 or b>127) bv=-bv sfx(1)
 if (c<0 or c>127) cv=-cv sfx(2)
 if (d<0 or d>127) dv=-dv sfx(3)
 
 --change color
 if i>3 then
  if cycle then
   --cycle
   color(palette[j])
   j+=1
   if (j>#palette) j=1
  else
   --randomly select
   color(rnd_col())
  end
  i=0
 end
 
 --play the beat?
end

function _draw()
 --runs after _update
 --but runs after every 2
 --if there's a speed issue
 line(a, b, c, d)
end
