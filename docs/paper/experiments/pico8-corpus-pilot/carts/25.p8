pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- thanks
-- by matt van der westhuizen
function _init()
 _frm=0
 _col=1
 _pal={0,1,2,136,8,137,9,10,138,11,139,131,140,12,13,14}
 for i,c in pairs(_pal) do
 	pal(i-1,c,1)
 end
end

function _draw()
 cls()
 spr(0,0,40,16,5)
end

function _update()
 _frm+=1
 
 if _frm%3==0 then
  _col+=1
  if _col>15 then
   _col=1
  end
  pal(1,_col)
 end
end
