pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	music(0)
end

function _update()
	celesteanim+=1
end

celesteanim = 0

function _draw()
	cls()
	
 --stars 
	fall2(60, 10, 0.1, 8)
 fall2(6, 47, 0.5, 9)
 fall2(45, 120, 0.7, 10)
 fall2(79, 106, 0.3, 11)
 fall2(18, 36, 0.8, 12)
 fall2(122, 33, 0.7, 14)
 fall2(1, 81, 0.8, 8)
 fall2(27, 62, 0.4, 9)
 fall2(112, 57, 0.9, 10)
 fall2(43, 86, 0.1, 11) 
	 
 fall(60, 10, 0.1, 8)
 fall(6, 47, 0.5, 9)
 fall(45, 120, 0.7, 10)
 fall(79, 106, 0.3, 11)
 fall(18, 36, 0.8, 12)
 fall(120, 33, 0.7, 14)
 fall(1, 81, 0.8, 8)
 fall(27, 62, 0.4, 9)
 fall(112, 57, 0.9, 10)
 fall(43, 86, 0.1, 11)
	
	--border
	rect(0, 0, 127, 127, 7)
	rect(0, 0, 3, 3, 7)
	rect(0, 124, 3, 127, 7)
	rect(124, 0, 127, 3, 7)
	rect(124, 124, 127, 127, 7)
	--logo
	spr(8, 31, -6, 8, 8)
	
	--text
	palt(0, false)
	rectfill(18, 53, 108, 80, 0)
	palt(0, true)
	rect(18, 53, 108, 80, 7)
	
	rect(16, 51, 18, 53, 7)
	rect(16, 80, 18, 82, 7)
	rect(108, 51, 110, 53, 7)
	rect(108, 80, 110, 82, 7)
	
	title = "03 - ressurections"
	title2 = "(pico-8 remix)"
	artist = "by rubyred"
	original = "original by lena raine"
	print(title, 28, 55, 7)
	print(title2, 36, 61, 7)
	print(artist, 44, 67, 7)
	print(original, 20, 73, 7)
	
 --rocks
 float(113, 6, 105, 0)
 float(115, 18, 87, 0.2)
 float(114, 105, 88, 0.6)
 float(116, 110, 111, 0.85) 

	--mirror
	palt(11, true)
	palt(0, false)
	spr(128,32, 78, 4, 5.2)
	spr(128,62, 78, 4, 5.2, 1)
	palt(11, false)
	palt(0, true)
	
	spr(0, 31, 119, 8, 1) 
	spr(112, 23, 119) 
	spr(112, 95, 119, 1, 1,  true)
	--characters 
	drawanim(64, 69, 102, true)
	spr(132, 32, 78, 8, 5.2)
	drawanim(16, 41, 102, false)
end

function drawanim(start, x, y, fl)
	palt(11, true)
	palt(0, false)
	local test = ((celesteanim%30)/30)
	test = test*test
	test = test*4
	test = flr(test)
	spr(start+test*2, x, y, 2, 2.2, fl)
	palt(11, false)
	palt(0, true)
end

function float(sprite, x, y, off)
	spr(sprite, x, y+(sin((celesteanim/150)+off%1)*3))
end

function fall(x, y, off, col)
	local test = ((celesteanim%50)/50)+off
	test = sin(test)+1
	test = test*1.5
	test = flr(test)
	pal(11, col)
	spr(223+test, x, (y+(celesteanim*(0.5+off)%128))%128)
	pal(11, 11)
end

function fall2(x, y, off, col)
	local test = ((celesteanim%50)/50)+off
	test = sin(test)+1
	test = test*1.5
	test = flr(test)
	pal(11, col)
	spr(117+test, 128-x, (128-y+(celesteanim*(0.5+off)%128))%128)
	pal(11, 11)
end
