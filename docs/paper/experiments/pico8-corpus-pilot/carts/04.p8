pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	frame = 0
	anim = true
	text=1
	rainbow = {6,7,8,9,10,11,12,13}
end

function _update()
	if frame<8 and anim then
		frame+=0.4
	else
		frame=8
	end
end

function _draw()
	cls()
	boot(flr(frame),0)
	if frame==8 and anim then
		sfx(0)
		frame=0
		anim = false
	end
	if anim==false then
		spr(1,0,0,5,2)
		if text > 2 then
			print('pico-8 0.2.4',0,18,6)
		end
		if text > 3 then
			print('(c) 2014-21 lexaloffle games llp',0,24,6)
			print('booting cartridge..',0,36,6)
			print('',0,42,0)
		end
		text+=0.4
		if text > 20 then _init() end
	end
end

function colorful_line(phase, shift, x, space)
	for i = 0, 16 do
		for j = 0, 3 do
			pset(x, (i*4+j)*space+shift, rainbow[((i-1)+phase)%8+1])
		end
	end
end

function random_line(a,b,x,space)
	range=b-a+1
	for i=0,127 do
		pset(x,i*space,flr(rnd(range))+a)
	end
end

function boot(frame,x)
	srand(2)
	if frame==0 then
		for i = 0,15 do
			random_line(0,5,i*8+2+x,1)
		end
	end
	if frame==1 then
		boot(0, x)
		for i = 0,15 do
			colorful_line(1+i,0,i*8+x,2)
		end
		for i = 0,16 do
			colorful_line(1+i,-4,i*8+4+x,2)
		end
	end
	if frame==2 then
		boot(1,x)
		for i = 0, 31 do
			random_line(10,13,i*4+2+x,3)
		end
	end
	if frame==3 then
		boot(2,-1)
		boot(2,x)
	end
	if frame==4 then
		boot(3,x)
		for i = 0, 31 do
			rectfill(x,i*4+1,x+128,i*4+3,0)
		end
	end
	if frame>4 then cls() end
end
