pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- the great rubber band ball
-- by: jack hanson

function _init()
 cls(6)
 size=40
 t=time()
end

function _update()
 -- grow every 4 seconds
 if((time()-t)%4==0) then
  size+=1
 end
 
 if(size>80) _init()
end

function _draw()
 make_band()
end

function make_band()
 ang1=rnd(6.28) -- 2*pi
 x1=size+size*cos(ang1)
 y1=size+size*sin(ang1)
 
 ang2=rnd(6.28)
 x2=size+size*cos(ang2)
 y2=size+size*sin(ang2)
 
 line(x1,y1,x2,y2, rnd(15))
end
